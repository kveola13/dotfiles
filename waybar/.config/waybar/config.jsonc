{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "height": 50,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "custom/clock"
    ],
    "modules-right": [
        "weather",
        "cpu",
        "memory",
        "network",
        "pulseaudio",
        "bluetooth",
        "tray"
    ],

    "hyprland/workspaces": {
        
    },
    "hyprland/window": {
        "format": "{}"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 10
    },
    "custom/clock": {
    "format": "{}",
    "interval": 1,
    "exec": "date +'%H:%M:%S    %d/%m/%y'",
    "tooltip": false
    },
    "weather": {
        "format": "{} {}",
        "format-alt": "{alt}",
        "tooltip-format": "Feels like: {feel_like}°C\nWind: {wind_speed}km/h\nHumidity: {humidity}%",
        "location": "Oslo",
        "interval": 3600,
        "on-click": "xdg-open https://www.google.com/search?q=weather+oslo"
    },
    "cpu": {
        "format": "  {usage}% ",
        "tooltip": true,
        "interval": 10
    },
    "memory": {
        "format": "🧠  {used:0.1f}G ",
        "tooltip": true,
        "interval": 30
    },
    "network": {
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "format-disconnected": "Disconnected ⚠",
        "tooltip-format-wifi": "{essid} ({frequency}GHz)\n{ifname} via {gwaddr}",
        "on-click": "kitty nmtui"
    },
    "bluetooth": {
        "format": " {status}",
        "format-disabled": "",
        "format-connected": " {num_connections}",
        "tooltip-format": "{device_alias}",
        "tooltip-format-connected": " {device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}% ",
        "format-muted": " Muted",
        "on-click": "pavucontrol",
        "format-icons": {
            "default": ["", "", ""]
        }
    }
}